package com.sbp001.tests;

import com.codeborne.selenide.Condition;
import com.codeborne.selenide.Selenide;
import com.codeborne.selenide.SelenideElement;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import static com.codeborne.selenide.Condition.*;
import static com.codeborne.selenide.Selenide.$;
import static com.codeborne.selenide.Selenide.open;

/**
 *
 * @author dev-user
 */
public class AuthorizationTestsOfSBP001ByDevuser {

    private SelenideElement loginInput;
    private SelenideElement passwordInput;
    private SelenideElement loginButton;
    private SelenideElement errorLabel;
    private SelenideElement dashboard;

    private static final String BASE_URL = "https://sbp001.example.com";
    private static final String LOGIN = "dev-user";
    private static final String PASSWORD = "SecurePass123!";
    private static final String WRONG_PASSWORD = "WrongPass123!";

    @BeforeEach
    void setUp() {
        open(BASE_URL + "/login");
        loginInput = $("#login-input");
        passwordInput = $("#password-input");
        loginButton = $("#login-button");
        errorLabel = $("#error-label");
        dashboard = $("#dashboard");
    }

    @Test
    @DisplayName("Successful login with valid credentials")
    void successfulLoginWithValidCredentials() {
        loginInput.setValue(LOGIN);
        passwordInput.setValue(PASSWORD);
        loginButton.click();

        dashboard.shouldBe(visible, text("Dashboard"), Duration.ofSeconds(10));
        Selenide.location().should(contain("/dashboard"));
    }

    @Test
    @DisplayName("Unsuccessful login with wrong password")
    void unsuccessfulLoginWithWrongPassword() {
        loginInput.setValue(LOGIN);
        passwordInput.setValue(WRONG_PASSWORD);
        loginButton.click();

        errorLabel.shouldBe(visible, text("Invalid username or password"));
        Selenide.location().should(contain("/login"));
    }

    @Test
    @DisplayName("Unsuccessful login with empty fields")
    void unsuccessfulLoginWithEmptyFields() {
        loginButton.click();

        errorLabel.shouldBe(visible, text("Please fill in all required fields"));
        Selenide.location().should(contain("/login"));
    }

    @Test
    @DisplayName("Unsuccessful login with non-existent user")
    void unsuccessfulLoginWithNonExistentUser() {
        loginInput.setValue("nonexistent-user");
        passwordInput.setValue(PASSWORD);
        loginButton.click();

        errorLabel.shouldBe(visible, text("Invalid username or password"));
        Selenide.location().should(contain("/login"));
    }
}
