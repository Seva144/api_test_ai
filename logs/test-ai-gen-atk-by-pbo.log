package core.web.operations.login;

import core.base.operations.OperationType;
import core.base.test.TestException;
import core.web.po.pages.login.LoginPage;
import core.web.po.pages.mainmenu.MainMenuPage;
import core.web.po.pages.mainmenu.MainMenu;
import qa.tests.TestException;

import java.util.HashMap;

public class Ow14624_1 extends WebOperation {

    private String user;
    private String password;

    @Override
    public void setOperationType() {
        operationType = OperationType.Ow14624;
    }

    @Override
    public void create(HashMap<String, String> dataRow) throws TestException {
        step("1");
        _login(user, password);

        step("2");
        MainMenuPage menuPage = new MainMenuPage(getWebDriver());
        menuPage.mustAppear();
        menuPage.clickEnterPaymentOrders();
        menuPage.clickInventoryPrEnter();

        LoginPage loginPage = new LoginPage(getWebDriver());
        loginPage.mustAppear();

        step("3");
        loginPage.setUserName(user);
        loginPage.setPassword(password);
        loginPage.clickLogin();
    }
}
